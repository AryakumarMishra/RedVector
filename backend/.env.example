# API keys with Free Tier Available
# Can choose any (accordingly adjust the JUDGE_MODEL below)
GROQ_API_KEY=
GEMINI_API_KEY=

# Set only if want to test against OpenAI and/or Anthropic models.
# Requires billing setup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# If want to test without any API key
OLLAMA_API_BASE=http://localhost:11434



# For RedVector Probe. The evaluator uses LLM-as-a-Judge for more accurate results.
JUDGE_MODEL=groq/llama-3.1-8b-instant

# Set to "false" to skip the LLM-judge call entirely and rely only on relevance scoring + refusal-phrase detection. 
# Useful when hitting free-tier rate limits and want to run a big batch without judge calls.
USE_JUDGE_DEFAULT=true
